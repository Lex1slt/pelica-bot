# ========= 佩丽卡监督 配置模板 =========
# 复制为 .env 并填入真实值。.env 已被 .gitignore 排除，绝不提交。

# ---- LLM (DeepSeek, OpenAI 兼容) ----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
LLM_TEMPERATURE=1.1
LLM_MAX_TOKENS=600

# ---- 微信桥接 ----
# mock=本地开发；wxhook=WeChat-Hook+微信4.1.10.27（免费，当前路线）；pyweixin=UI自动化备用；wechaty=PadLocal付费
WXHOOK_API_URL=http://127.0.0.1:30001
BRIDGE_MODE=mock
# PadLocal token（生产必填）
WECHATY_TOKEN=
# 机器人自身微信 ID（生产用于过滤自己发的消息；mock 模式忽略）
BOT_WXID=
# 允许发言的群：群名或群 ID，逗号分隔；留空=不过滤（仅建议开发用）
GROUP_WHITELIST=
# 被 @ 的触发称呼（除微信原生 @ 外的文本触发词），逗号分隔
AT_ALIASES=佩丽卡监督,佩丽卡,Pelica

# ---- 路径（均可相对项目根） ----
CORPUS_DIR=corpus/releases
DATA_DIR=data
LOG_DIR=logs

# ---- 抖音解析 ----
# 内置零成本方案：curl_cffi Chrome 指纹 + ttwid + 分享页 item_list，2026-09 真实链接实测通过
DOUYIN_ENABLED=true
DOUYIN_DOWNLOAD_DIR=data/douyin
# 可选备用：第三方解析服务（http://host:port/api?url=<分享链接>，响应含
# video_url/url/play_addr 均可）。配置后优先于内置解析，抖音再次变更时的后门。
DOUYIN_RESOLVER_API=
# 本地视频缓存保留时长（小时），超时自动清理
DOUYIN_KEEP_HOURS=48

# ---- B 站解析 ----
BILIBILI_ENABLED=true

# ---- 每周统计播报 ----
TIMEZONE=Asia/Shanghai
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_WEEKDAY=fri
WEEKLY_REPORT_TIME=18:00

# ---- 告警（可选）：wecom=企业微信机器人 | generic=POST {"text":...} | none ----
ALERT_KIND=none
ALERT_WEBHOOK_URL=
# 桥接连续失败多少次触发告警
ALERT_FAILURE_THRESHOLD=3

# ---- 日志 ----
LOG_LEVEL=INFO
