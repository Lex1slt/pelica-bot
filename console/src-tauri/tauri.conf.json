{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pelica Console",
  "version": "1.1.0",
  "identifier": "com.pelica.console",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5179",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pelica Console",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-running.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "Pelica Console"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../gateway-dist": "gateway-dist/",
      "../../characters": "characters/"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
